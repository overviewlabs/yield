{
  "$schema": "https://tr.designtokens.org/format/",
  "brand": {
    "accent": { "$type": "color", "$value": "#4355D8" },
    "accentDark": { "$type": "color", "$value": "#8390FF" },
    "ink": { "$type": "color", "$value": "#11131A" },
    "paper": { "$type": "color", "$value": "#F5F6FA" }
  },
  "semantic": {
    "positive": { "$type": "color", "$value": "#16794B" },
    "negative": { "$type": "color", "$value": "#B33A3A" },
    "warning": { "$type": "color", "$value": "#9A5A08" },
    "neutral": { "$type": "color", "$value": "#626875" }
