# Runtime environment. Demo is the only safe default.
APP_ENV=demo
PORT=8080
DATABASE_URL=postgresql://whox:whox@localhost:5432/whox_treasury
# Paper only: a separate login granted exclusively to whox_app_store_notifications.
APP_STORE_DATABASE_URL=
REDIS_URL=redis://localhost:6379
# Set to 1 behind the production ALB; keep 0 for direct local connections.
TRUSTED_PROXY_HOPS=0
PUBLIC_API_URL=http://localhost:8080
CONNECT_WEB_URL=http://localhost:4173
ADMIN_WEB_URL=http://localhost:4174

# These seven values must remain false outside a formally approved Live release.
LIVE_TRADING_ENABLED=false
ROBINHOOD_PRODUCTION_APPROVED=false
LEGAL_DOCUMENTS_APPROVED=false
ADVISORY_COMPLIANCE_APPROVED=false
APP_STORE_FINANCIAL_ENTITY_APPROVED=false
OPTIONS_LIVE_TRADING_ENABLED=false
AUTONOMOUS_MODE_ENABLED=false

# Official remote MCP endpoint. Tokens are resolved server-side from an encrypted store.
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
BROKER_TOKEN_ENCRYPTION_KEY_ID=local-development-key-not-for-production
# Paper snapshot hydration. The default service artifact contains no broker
# adapter and refuses startup; these values apply only to a separately reviewed
# composition root that injects the approved connector in process.
BROKER_SNAPSHOT_MAX_AGE_SECONDS=60
BROKER_SYNC_INTERVAL_SECONDS=45

# Paper scheduling and authoritative quotes. Provider IDs are configuration,
# never inferred from response payloads. Keep the configured ID in the explicit
# allowlist; credentials remain isolated to market-data-service.
MARKET_DATA_PROVIDER_ID=
APPROVED_MARKET_DATA_PROVIDERS=
MARKET_DATA_PROVIDER_URL=
MARKET_DATA_PROVIDER_TOKEN=
AGENT_SCHEDULER_POLL_MS=15000
AGENT_SCHEDULER_BATCH_SIZE=250
AGENT_SCHEDULER_LAG_ALERT_SECONDS=300

AGENT_SCHEDULER_MAX_OUTSTANDING_JOBS=1000

# Paper plan research. HERMES_API_KEY must be injected from a managed secret;
# never copy a key from chat, source control, a mobile client, or this file.
# Keep the attestation false until the dedicated remote profile is independently
# verified stateless with terminal, file, web, memory, skills, plugins, MCP,
# cron, and delegation disabled at the provider.
HERMES_BASE_URL=https://treasury-bot.whox.ai/v1
HERMES_MODEL=treasury-bot
HERMES_API_KEY=
HERMES_RESEARCH_PROFILE_TOOLS_DISABLED=false

# Authentication and integrations. Development providers fail closed when unset.
APPLE_CLIENT_ID=
APPLE_BUNDLE_ID=ai.whox.metis
APPLE_APP_ID=
# Paper deployments accept App Store and TestFlight/Sandbox notifications.
STOREKIT_ENVIRONMENTS=sandbox,production
# One or more official Apple PKI root certificates in PEM form; keep raw JWS out of logs.
APPLE_ROOT_CA_BUNDLE=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_TOPIC=ai.whox.metis
APNS_ENVIRONMENTS=sandbox
APP_ATTEST_TEAM_ID=

# Web session and pairing security. Replace for every deployed environment.
SESSION_SIGNING_SECRET=replace-with-at-least-32-random-bytes
PAIRING_HASH_PEPPER=replace-with-a-different-random-secret
# HMACs client addresses before they enter the distributed rate-limit keyspace.
RATE_LIMIT_KEY_SECRET=replace-with-a-third-distinct-random-secret
# Required in Paper. API encrypts APNs token bytes with SHA-256(key) + AES-256-GCM.
DEVICE_TOKEN_ENCRYPTION_KEY=replace-with-a-fourth-distinct-random-secret

# Observability. Financial values and secrets must never be sent as attributes.
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
